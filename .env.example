# Higgsfield Cloud API credentials  —  TEMPLATE
#
# HOW TO USE:
#   1. Make a COPY of this file in the same folder, named exactly:  .env
#   2. Paste your key values after the = signs below (no quotes, no spaces).
#   3. Save. The server reads them automatically when you run: node server.js
#
# Your real .env file is git-ignored, so it is NEVER pushed to GitHub. Keep it that way.
# Never paste the SECRET into index.html or anywhere public.

# The Key ID — shown in your Higgsfield Cloud dashboard under API Keys (the "ID" column).
HF_API_KEY_ID=

# The Secret — the value shown ONCE when you created the key, that you saved on your PC.
HF_API_KEY_SECRET=
